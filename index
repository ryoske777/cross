<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>모멘텀 신호 체크 — 업그레이드 분석기</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="stylesheet" as="style" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.css">
    <style>
        :root {
            --bg: #faf8f3; --surface: #ffffff; --text: #1f1f1d;
            --text-secondary: #6c6c66; --text-tertiary: #a8a8a0;
            --border: rgba(0,0,0,0.08); --good: #2d8659; --good-bg: #e8f5ee;
            --bad: #c44343; --bad-bg: #fcebec; --neutral: #b07d2e;
            --neutral-bg: #fbf2e1; --primary: #1a4d8c; --primary-hover: #0e3a73;
            --price: #1a4d8c; --ma50: #d97942; --ma200: #6c6c66;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: "Pretendard Variable", sans-serif;
            background: var(--bg); color: var(--text);
            padding: 24px 16px; min-height: 100vh; line-height: 1.5;
        }
        .container { max-width: 720px; margin: 0 auto; }
        .card { background: var(--surface); border-radius: 12px; padding: 20px; margin-bottom: 14px; border: 1px solid var(--border); }
        .search-row { display: flex; gap: 10px; }
        .ticker-input { flex: 1; max-width: 160px; padding: 11px; border-radius: 8px; border: 1.5px solid var(--border); text-transform: uppercase; outline: none; }
        .ticker-input:focus { border-color: var(--primary); }
        button.primary { background: var(--primary); color: white; border: none; padding: 11px 20px; border-radius: 8px; cursor: pointer; font-weight: 600; }
        .quick-buttons { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }
        .quick-btn { background: white; border: 1px solid var(--border); padding: 5px 12px; font-size: 12px; border-radius: 6px; cursor: pointer; }
        .metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
        @media (min-width: 480px) { .metrics { grid-template-columns: repeat(4, 1fr); } }
        .metric { padding: 14px; background: var(--bg); border-radius: 8px; }
        .metric-label { font-size: 11px; color: var(--text-secondary); }
        .metric-value { font-size: 18px; font-weight: 700; }
        .signal { padding: 12px; margin: 6px 0; border-radius: 8px; display: flex; justify-content: space-between; font-size: 14px; }
        .signal-good { background: var(--good-bg); color: var(--good); }
        .signal-bad { background: var(--bad-bg); color: var(--bad); }
        .signal-neutral { background: var(--neutral-bg); color: var(--neutral); }
        .summary { margin-top: 14px; padding: 16px; border-radius: 10px; font-weight: 700; text-align: center; }
        svg.chart { width: 100%; height: auto; margin-top: 10px; }
        .footer { text-align: center; color: var(--text-tertiary); font-size: 12px; margin-top: 20px; }
    </style>
</head>
<body>
<div class="container">
    <header style="margin-bottom:20px">
        <h1>📊 모멘텀 신호 체크</h1>
        <p style="color:var(--text-secondary); font-size:14px">50일·200일 이동평균선 기반 기술적 분석</p>
    </header>
    
    <div class="card">
        <div class="search-row">
            <input type="text" id="ticker" class="ticker-input" value="TSM" placeholder="TICKER">
            <button class="primary" id="searchBtn">분석하기</button>
        </div>
        <div class="quick-buttons">
            <button class="quick-btn" data-ticker="TSM">TSM</button>
            <button class="quick-btn" data-ticker="NVDA">NVDA</button>
            <button class="quick-btn" data-ticker="AAPL">AAPL</button>
            <button class="quick-btn" data-ticker="QQQ">QQQ</button>
        </div>
    </div>

    <div id="status" style="display:none; text-align:center; padding:20px;"></div>

    <div id="results" style="display:none">
        <div class="card">
            <div class="metrics" id="metrics"></div>
        </div>
        <div class="card">
            <div id="signals"></div>
            <div id="summary"></div>
        </div>
        <div class="card">
            <div style="font-size:12px; font-weight:600; color:var(--text-secondary); margin-bottom:10px">6개월 추세 차트</div>
            <svg id="chart" viewBox="0 0 700 320"></svg>
        </div>
    </div>
    <div class="footer">데이터 출처: Stooq.com / 실시간 데이터가 아니므로 투자에 유의하세요.</div>
</div>

<script>
const tickerInput = document.getElementById('ticker');
const searchBtn = document.getElementById('searchBtn');
const resultsDiv = document.getElementById('results');
const statusDiv = document.getElementById('status');

searchBtn.addEventListener('click', () => analyze(tickerInput.value.trim().toUpperCase()));
document.querySelectorAll('.quick-btn').forEach(b => b.addEventListener('click', () => analyze(b.dataset.ticker)));

async function analyze(ticker) {
    if(!ticker) return;
    showStatus('데이터 분석 중...', false);
    resultsDiv.style.display = 'none';

    try {
        const csv = await fetchStockData(ticker);
        const rawData = parseCSV(csv);
        if (rawData.length < 200) throw new Error("분석을 위한 데이터(200일분)가 부족합니다.");

        // 데이터 정렬 (날짜 오름차순)
        const data = rawData.sort((a, b) => a.date.localeCompare(b.date));
        const closes = data.map(d => d.close);
        
        // 지표 계산
        const ma50 = calculateSMA(closes, 50);
        const ma200 = calculateSMA(closes, 200);
        
        const current = {
            price: closes[closes.length - 1],
            ma50: ma50[ma50.length - 1],
            ma200: ma200[ma200.length - 1],
            high52: Math.max(...closes.slice(-252)),
            date: data[data.length - 1].date
        };

        renderUI(ticker, current, ma50, ma200, data);
        statusDiv.style.display = 'none';
        resultsDiv.style.display = 'block';
    } catch (err) {
        showStatus(err.message, true);
    }
}

async function fetchStockData(ticker) {
    const url = `https://stooq.com/q/d/l/?s=${ticker}.us&i=d`;
    const proxy = `https://api.allorigins.win/raw?url=${encodeURIComponent(url)}`;
    
    const resp = await fetch(proxy);
    if (!resp.ok) throw new Error("네트워크 응답에 실패했습니다.");
    const text = await resp.text();
    if (text.includes("<html>") || text.length < 100) throw new Error("유효한 티커가 아니거나 데이터를 찾을 수 없습니다.");
    return text;
}

function parseCSV(csv) {
    const lines = csv.trim().split('\n');
    const header = lines[0].toLowerCase().split(',');
    const closeIdx = header.indexOf('close');
    const dateIdx = header.indexOf('date');
    
    return lines.slice(1).map(line => {
        const cols = line.split(',');
        return { date: cols[dateIdx], close: parseFloat(cols[closeIdx]) };
    }).filter(d => !isNaN(d.close));
}

function calculateSMA(data, period) {
    let result = new Array(data.length).fill(NaN);
    let sum = 0;
    for (let i = 0; i < data.length; i++) {
        sum += data[i];
        if (i >= period) sum -= data[i - period];
        if (i >= period - 1) result[i] = sum / period;
    }
    return result;
}

function showStatus(msg, isError) {
    statusDiv.style.display = 'block';
    statusDiv.textContent = msg;
    statusDiv.style.color = isError ? 'var(--bad)' : 'var(--text-secondary)';
}

function renderUI(ticker, cur, ma50, ma200, allData) {
    // 1. Metrics
    const dist52 = (cur.price / cur.high52 * 100).toFixed(1);
    document.getElementById('metrics').innerHTML = `
        <div class="metric"><div class="metric-label">${ticker} 종가</div><div class="metric-value">$${cur.price.toFixed(2)}</div></div>
        <div class="metric"><div class="metric-label">50일선</div><div class="metric-value">$${cur.ma50.toFixed(2)}</div></div>
        <div class="metric"><div class="metric-label">200일선</div><div class="metric-value">$${cur.ma200.toFixed(2)}</div></div>
        <div class="metric"><div class="metric-label">52주 고점대비</div><div class="metric-value">${dist52}%</div></div>
    `;

    // 2. Signals
    const signals = [];
    const crossInfo = checkCross(ma50, ma200);

    if (cur.price > cur.ma200) signals.push({type:'good', txt:'주가가 200일선 위에 있습니다. (장기 우상향)'});
    else signals.push({type:'bad', txt:'주가가 200일선 아래에 있습니다. (장기 하락세)'});

    if (crossInfo === 'golden') signals.push({type:'good', txt:'✨ 최근 골든크로스가 발생했습니다!'});
    else if (cur.ma50 > cur.ma200) signals.push({type:'good', txt:'이평선 정배열 상태입니다.'});
    else signals.push({type:'bad', txt:'이평선 역배열 상태입니다.'});

    document.getElementById('signals').innerHTML = signals.map(s => 
        `<div class="signal signal-${s.type}"><span>${s.type==='good'?'✓':'✗'} ${s.txt}</span></div>`
    ).join('');

    const goodCount = signals.filter(s => s.type === 'good').length;
    const sumEl = document.getElementById('summary');
    sumEl.className = 'summary ' + (goodCount === 2 ? 'signal-good' : goodCount === 1 ? 'signal-neutral' : 'signal-bad');
    sumEl.textContent = goodCount === 2 ? "🟢 매수 우위 모멘텀" : goodCount === 1 ? "🟡 중립/관망 필요" : "🔴 매도/위험 구간";

    // 3. Chart (최근 120일)
    drawSimpleChart(allData.slice(-120).map(d => d.close), ma50.slice(-120), ma200.slice(-120));
}

function checkCross(ma50, ma200) {
    const n = ma50.length;
    for(let i=0; i<10; i++) { // 최근 10일 이내 발생 여부
        if(ma50[n-1-i] > ma200[n-1-i] && ma50[n-2-i] <= ma200[n-2-i]) return 'golden';
        if(ma50[n-1-i] < ma200[n-1-i] && ma50[n-2-i] >= ma200[n-2-i]) return 'dead';
    }
    return null;
}

function drawSimpleChart(prices, m50, m200) {
    const svg = document.getElementById('chart');
    const W = 700, H = 320, pad = 40;
    const min = Math.min(...prices, ...m50.filter(v=>!isNaN(v)), ...m200.filter(v=>!isNaN(v))) * 0.95;
    const max = Math.max(...prices, ...m50, ...m200) * 1.05;
    
    const getX = (i) => (i / (prices.length - 1)) * (W - pad * 2) + pad;
    const getY = (v) => H - ((v - min) / (max - min)) * (H - pad * 2) - pad;

    const line = (data, color, dash) => {
        let path = `M ${getX(0)} ${getY(data[0])} `;
        data.forEach((v, i) => { if(i>0) path += `L ${getX(i)} ${getY(v)} `; });
        return `<path d="${path}" fill="none" stroke="${color}" stroke-width="${dash?1:2}" ${dash?'stroke-dasharray="4 2"':''}/>`;
    };

    svg.innerHTML = line(m200, 'var(--ma200)', true) + line(m50, 'var(--ma50)', false) + line(prices, 'var(--price)', false);
}

// 초기 로딩
window.onload = () => analyze('TSM');
</script>
</body>
</html>
